{
  "name": "guruguard-extension",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "build": "esbuild src/background/local-worker.ts src/content/content.ts src/popup/popup.ts --bundle --format=esm --outdir=dist --outbase=src --sourcemap && npm run copy:static",
    "copy:static": "node scripts/copy-static.mjs",
    "package": "npm run build && python scripts/package.py",
    "watch": "esbuild src/background/local-worker.ts src/content/content.ts src/popup/popup.ts --bundle --format=esm --outdir=dist --outbase=src --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "esbuild": "0.28.2",
    "typescript": "~5.3.3",
    "vitest": "5.0.0",
    "jsdom": "29.1.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.1"
  },
  "description": "Public Instagram profile checks with local rules and user-controlled blocking.",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cobanfurkanx/guruguard-extension.git"
  },
  "dependencies": {
    "zod": "3.25.76"
  }
}
